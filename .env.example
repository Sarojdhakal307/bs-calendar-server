# Server configuration for bs-server.
#   cp .env.example .env && chmod 600 .env
# Fill in every CHANGE_ME. Generate each secret with:  openssl rand -hex 32
# Keep comments on their own lines (text after a value becomes part of the value).
# .env is git-ignored: never commit it with real values.

# ---- Image and address -----------------------------------------------------------------
# Tag of ghcr.io/sarojdhakal307/calendar-api (releases of the bs-calendar repository)
VERSION=v1.1.1
# Port on this machine for the website, API, dashboard and docs (nginx on the server proxies to it)
WEB_PORT=8080
# CHANGE_ME: the public address nginx serves
PUBLIC_BASE_URL=https://calendar.example.com
APP_ENV=production

# ---- Database (runs in Docker on this server, service "calender-db") ------------------
POSTGRES_USER=calendar_admin
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
# Letters and digits only. Paste the same two values into the URLs below
# (or percent-encode special characters, e.g. @ becomes %40).
CALENDAR_OWNER_PASSWORD=CHANGE_ME_owner_password
CALENDAR_APP_PASSWORD=CHANGE_ME_app_password
MIGRATION_DATABASE_URL=postgres://calendar_owner:CHANGE_ME_owner_password@calender-db:5432/calendar?sslmode=disable
DATABASE_URL=postgres://calendar_app:CHANGE_ME_app_password@calender-db:5432/calendar?sslmode=disable

# ---- Secrets: two different random values ----------------------------------------------
JWT_SIGNING_KEY=CHANGE_ME_64_hex_characters_from_openssl_rand_hex_32_aaaaaaaa
# Never change this one after the first start (it encrypts stored webhook secrets)
WEBHOOK_SECRET_KEY=CHANGE_ME_64_hex_characters_from_openssl_rand_hex_32_bbbbbbbb

# ---- First admin: created on first start; change the password after logging in --------
BOOTSTRAP_ADMIN_EMAIL=you@example.com
# At least 12 characters
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_long_password

# ---- HTTP -------------------------------------------------------------------------------
# nginx forwards the real client IP
TRUST_PROXY=true
# CHANGE_ME: your website(s), comma-separated
CORS_ALLOWED_ORIGINS=https://www.example.com
# Optional: limit the admin API to these addresses, e.g. 203.0.113.10/32,10.0.0.0/8
ADMIN_ALLOWED_CIDRS=
REQUIRE_API_KEY=true
ALLOW_PRIVATE_WEBHOOKS=false
MIN_SUPPORTED_CLIENT=1.0.0
LOG_LEVEL=info
LOG_FORMAT=json
