# nginx site for the calendar. Copy it into place and set your domain:
#   sudo cp nginx-site.conf.example /etc/nginx/sites-available/calendar-api.conf
#   sudo sed -i 's/calendar.example.com/YOUR.DOMAIN/g' /etc/nginx/sites-available/calendar-api.conf
# Sends the domain to the "api" container (127.0.0.1:WEB_PORT), which serves:
#   /  website    /api  API    /admin  dashboard    /docs  API reference
# HTTPS is added by: sudo certbot --nginx -d YOUR.DOMAIN

server {
    listen 80;
    server_name calendar.example.com;

    client_max_body_size 10m;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
